if [ "$(command -v gpgconf)" != "" ]; then
    PrintTrace "$TRACE_INFO" "  [🎬 Initializing gpg-agent as ssh-agent (YubiKey) ...]"
    export GPG_TTY=$(tty)
    unset SSH_AGENT_PID
    export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
    gpgconf --launch gpg-agent
else
    PrintTrace "$TRACE_ERROR" "  ${YELLOW}gpg is not installed! Please install gnupg${NC}"
fi
