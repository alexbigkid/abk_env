if [ "$(command -v nodenv)" != "" ]; then
    PrintTrace "$TRACE_INFO" "  [🎬 Initializing nodenv ...]"
    eval "$(nodenv init -)"

elif [ -d "$HOME/.nodenv/bin" ]; then
    PrintTrace "$TRACE_INFO" "  [🎬 Initializing nodenv ...]"
    export NODENV_ROOT="$HOME/.nodenv"
    export PATH="$NODENV_ROOT/bin:$PATH"
    eval "$(nodenv init -)"

else
    PrintTrace "$TRACE_ERROR" "  ${YELLOW}nodenv is not installed${NC}"
fi


if [ "$(command -v mise)" != "" ]; then
    PrintTrace "$TRACE_INFO" "  [🎬 Initializing mise ...]"
    # zsh only
    [ "$ABK_SHELL" = "zsh" ] && eval "$(mise activate zsh)"
    # bash only
    [ "$ABK_SHELL" = "bash" ] && eval "$(mise activate bash)"
else
    PrintTrace "$TRACE_ERROR" "  ${YELLOW}mise is not installed! Please install mise${NC}"
fi
